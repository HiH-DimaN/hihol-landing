# --- Yandex Metrika ---
# ID счётчика Яндекс.Метрики.
# Если не задан — трекер и цели отключены (удобно локально).
# Задаётся в Coolify UI, не коммитится.
NEXT_PUBLIC_YM_ID=

# --- Lead form backend (server-only, NOT NEXT_PUBLIC) ---
# Internal address of the FastAPI form service on the Coolify network.
# The /api/lead route proxies submissions here. Set in Coolify UI.
FORM_API_URL=http://hihol-form-api:8000/leads

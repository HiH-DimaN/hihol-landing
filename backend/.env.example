# Production (RF host) uses PostgreSQL; local dev/tests fall back to SQLite.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@hihol-form-db:5432/hihol

# Telegram bot notification (leave empty to disable notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anti-spam throttle
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=600

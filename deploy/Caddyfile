# Coolify runs this container behind its Traefik proxy, which owns TLS and
# public ports 80/443. Caddy only serves the exported site on the internal port.

:3000 {
	root * /srv
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	respond /healthz 200

	# Redirect retained from the former Next runtime.
	redir /rag /kak-vnedrit-rag 301

	# Metadata image routes are extensionless files generated by Next.js.
	@metadata_image path /opengraph-image /twitter-image /icon /apple-icon
	header @metadata_image Content-Type image/png

	# Flat static export: /ai -> /ai.html while real files keep their paths.
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
